# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Secrets: never commit env files (the example file is allowed)
.env
.env.*
!.env.example

# Run outputs: bundles are generated, keep only the folder
bundles/*
!bundles/.gitkeep
# WS-03 live evidence is small (< 100 KB) and kept for review
!bundles/ws03/

