# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Secrets: never commit env files (the example file is allowed)
.env
.env.*
!.env.example
# Per-machine architect switch (WS-10): live calls are an owner decision, never committed
config/architect.yaml

# Run outputs: bundles are generated, keep only the folder
bundles/*
!bundles/.gitkeep
# WS-03 live evidence is small (< 100 KB) and kept for review
!bundles/ws03/
# WS-04 M0 bundles (raw tool results, small) are the evidence docs/M0.md cites
!bundles/m0/
# WS-09 B2 offline statistic (validator/graph only, no play): summary + gzipped records (~150 KB)
!bundles/b2_offline/
# Architect smoke calls (scripts/architect_smoke.py): request, raw reply, verdicts, usage; small, no secrets
!bundles/architect_smoke/
# WS-11 experiment bundles (scripts/run_experiment.py step): relay requests/answers, verdicts, summaries
!bundles/experiments/
# Episode-1 clip re-runs of the M0 gate scenes (small; the clip cites them)
!bundles/clip-2026-11-11/

# macOS
.DS_Store

# Roblox place files (the owner's local place; places/README.md lists its settings)
places/*.rbxl
places/*.rbxl.lock
