WS_SRC["ws_lib"] = [==[
-- Worldsmith event library (fixed template). One line per event:
-- WS|<nonce>|<EVENT>|id=<id>|pos=<x,y,z or na>|t=<server time>
local lib = {}
local root = script.Parent
local EVENTS = { LEVER_ACTIVATED = true, GATE_OPENED = true, BRIDGE_CROSSED = true, KILL_FLOOR_TOUCHED = true, GOAL_TOUCHED = true }

function lib.characterOf(hit)
    local model = hit and hit:FindFirstAncestorOfClass("Model")
    while model do
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum then
            if hum.Health > 0 then
                return model, hum
            end
            return nil
        end
        model = model:FindFirstAncestorOfClass("Model")
    end
    return nil
end

local function nonce()
    local n = root:GetAttribute("ws_nonce")
    if type(n) == "string" and #n >= 8 and #n <= 32 and string.match(n, "^[0-9a-f]+$") then
        return n
    end
    return "-"
end

function lib.emit(event, id, character)
    if not EVENTS[event] then
        return
    end
    local pos = "na"
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local p = hrp.Position - (root:GetAttribute("ws_origin") or Vector3.zero)
        pos = string.format("%.2f,%.2f,%.2f", p.X, p.Y, p.Z)
    end
    print(string.format("WS|%s|%s|id=%s|pos=%s|t=%.3f", nonce(), event, id, pos, workspace:GetServerTimeNow()))
end

return lib
]==]
WS_SRC["lever"] = [==[
-- Worldsmith lever (fixed template): touch its zone or trigger its prompt; latches on once.
local lever = script.Parent
local lib = require(lever:FindFirstAncestor("Worldsmith"):WaitForChild("ws_lib"))
local done = false
local function activate(character)
    if done then
        return
    end
    done = true
    lib.emit("LEVER_ACTIVATED", lever.Name, character)
    local handle = lever:FindFirstChild("handle")
    if handle then
        handle.Color = Color3.fromRGB(75, 151, 75)
    end
    lever:SetAttribute("ws_active", true)
end
lever:WaitForChild("zone").Touched:Connect(function(hit)
    local character = lib.characterOf(hit)
    if character then
        activate(character)
    end
end)
local prompt = lever:WaitForChild("handle"):WaitForChild("prompt")
prompt.Triggered:Connect(function(player)
    activate(player.Character)
end)
]==]
WS_SRC["gate"] = [==[
-- Worldsmith gate (fixed template): opens once its lever's ws_active becomes true.
local gate = script.Parent
local root = gate:FindFirstAncestor("Worldsmith")
local lib = require(root:WaitForChild("ws_lib"))
local lever = root:WaitForChild(gate:GetAttribute("ws_lever"))
local function sync()
    if lever:GetAttribute("ws_active") == true and gate:GetAttribute("ws_open") ~= true then
        gate:SetAttribute("ws_open", true)
        gate.CanCollide = false
        gate.Transparency = 0.8
        lib.emit("GATE_OPENED", gate.Name, nil)
    end
end
lever:GetAttributeChangedSignal("ws_active"):Connect(sync)
sync()
]==]
WS_SRC["trigger"] = [==[
-- Worldsmith trigger (fixed template): prints its ws_event once per character that enters it.
local zone = script.Parent
local lib = require(zone:FindFirstAncestor("Worldsmith"):WaitForChild("ws_lib"))
local event = zone:GetAttribute("ws_event")
local seen = setmetatable({}, { __mode = "k" })
zone.Touched:Connect(function(hit)
    local character = lib.characterOf(hit)
    if character and not seen[character] then
        seen[character] = true
        lib.emit(event, zone.Name, character)
    end
end)
]==]
WS_SRC["kill_floor"] = [==[
-- Worldsmith kill floor (fixed template): prints KILL_FLOOR_TOUCHED once per character, then
-- ends that character (Health = 0).
local floor = script.Parent
local lib = require(floor:FindFirstAncestor("Worldsmith"):WaitForChild("ws_lib"))
local seen = setmetatable({}, { __mode = "k" })
floor.Touched:Connect(function(hit)
    local character, humanoid = lib.characterOf(hit)
    if character and not seen[character] then
        seen[character] = true
        lib.emit("KILL_FLOOR_TOUCHED", floor.Name, character)
        humanoid.Health = 0
    end
end)
]==]

local root = Instance.new("Folder")
root.Name = "Worldsmith"
root:SetAttribute("ws_schema", "worldsmith.scene/0.1")
root:SetAttribute("ws_scene_hash", WS_HASH)
root:SetAttribute("ws_version", WS_VERSION)
root:SetAttribute("ws_origin", WS_ORIGIN)

local function ws_part(className, name, parent, sx, sy, sz, px, py, pz, yaw, color, transparency, canCollide)
    local p = Instance.new(className)
    p.Name = name
    p.Anchored = true
    p.Size = Vector3.new(sx, sy, sz)
    p.CFrame = CFrame.new(WS_ORIGIN + Vector3.new(px, py, pz)) * CFrame.Angles(0, math.rad(yaw), 0)
    p.Color = color
    p.Material = Enum.Material.SmoothPlastic
    p.Transparency = transparency
    p.CanCollide = canCollide
    p.CanTouch = true
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function ws_tag(inst, id, etype)
    inst:SetAttribute("ws_id", id)
    inst:SetAttribute("ws_type", etype)
end

local function ws_events(parent, key)
    local s = Instance.new("Script")
    s.Name = "ws_event"
    s.Source = WS_SRC[key]
    s.Parent = parent
end

do
    local lib = Instance.new("ModuleScript")
    lib.Name = "ws_lib"
    lib.Source = WS_SRC["ws_lib"]
    lib.Parent = root
end

